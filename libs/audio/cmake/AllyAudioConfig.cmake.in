@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" AND @ALLY_AUDIO_ALSA@)
    find_dependency(ALSA)
endif()
if("@PIPEWIRE_FOUND@")
    find_dependency(PkgConfig)
    pkg_check_modules(PIPEWIRE REQUIRED IMPORTED_TARGET libpipewire-0.3>=0.3.44)
endif()
if("@ALLY_AUDIO_RTKIT_FOUND@")
    find_dependency(PkgConfig)
    pkg_check_modules(SYSTEMD REQUIRED IMPORTED_TARGET libsystemd>=246)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/AllyAudioTargets.cmake")
