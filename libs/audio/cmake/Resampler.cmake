include(FetchContent)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(WITH_OPENMP OFF CACHE BOOL "" FORCE)
set(WITH_LSR_BINDINGS OFF CACHE BOOL "" FORCE)
set(WITH_CR32S OFF CACHE BOOL "" FORCE)
set(WITH_CR64S OFF CACHE BOOL "" FORCE)
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
function(ally_add_soxr source)
    # libsoxr 0.1.3 assumes a top-level module path; adapt it without changing upstream sources.
    set(CMAKE_POLICY_DEFAULT_CMP0127 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0115 OLD)
    set(LIB_INSTALL_DIR lib)
    set(INCLUDE_INSTALL_DIR include)
    set(DOC_INSTALL_DIR share/doc/libsoxr)
    list(APPEND CMAKE_MODULE_PATH "${source}/cmake/Modules")
    add_subdirectory("${source}" "${CMAKE_BINARY_DIR}/soxr" EXCLUDE_FROM_ALL)
endfunction()
if(EXISTS "${CMAKE_SOURCE_DIR}/third_party/soxr-0.1.3/CMakeLists.txt")
    ally_add_soxr("${CMAKE_SOURCE_DIR}/third_party/soxr-0.1.3")
else()
    FetchContent_Declare(soxr_source URL https://github.com/chirlu/soxr/archive/refs/tags/0.1.3.tar.gz
        URL_HASH SHA256=db6ca1b1e8405c6ef92f8294fc123d910abf0a114003b3f0f13fa57a95fd62d0)
    FetchContent_GetProperties(soxr_source)
    if(NOT soxr_source_POPULATED)
        FetchContent_Populate(soxr_source)
    endif()
    ally_add_soxr("${soxr_source_SOURCE_DIR}")
endif()
# Upstream's generic C dispatch casts compatible pointer ABIs; exclude only Clang function-type instrumentation.
if(ALLY_SANITIZERS AND CMAKE_C_COMPILER_ID MATCHES "Clang")
    target_compile_options(soxr PRIVATE -fno-sanitize=function)
endif()
add_library(ally_resampler "${PROJECT_SOURCE_DIR}/src/dsp/resample.cpp")
add_library(Ally::Resampler ALIAS ally_resampler)
set_target_properties(ally_resampler PROPERTIES EXPORT_NAME Resampler)
set_target_properties(soxr PROPERTIES EXPORT_NAME Soxr PUBLIC_HEADER "")
set_property(TARGET soxr PROPERTY LINK_INTERFACE_LIBRARIES)
target_compile_features(ally_resampler PUBLIC cxx_std_23)
target_include_directories(ally_resampler PUBLIC $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include> $<INSTALL_INTERFACE:include>)
target_link_libraries(ally_resampler PRIVATE soxr)
get_target_property(soxr_source_dir soxr SOURCE_DIR)
target_include_directories(ally_resampler PRIVATE "${soxr_source_dir}")
install(FILES "${soxr_source_dir}/../COPYING.LGPL" DESTINATION share/ally/licenses RENAME libsoxr.txt)

install(TARGETS ally_resampler soxr EXPORT AllyAudioTargets ARCHIVE DESTINATION lib LIBRARY DESTINATION lib PUBLIC_HEADER DESTINATION include/ally/audio/vendor)
