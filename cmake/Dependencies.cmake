include(FetchContent)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(ALLY_LIBDECOR QUIET libdecor-0)
endif()
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
if(EXISTS "${PROJECT_SOURCE_DIR}/third_party/SDL-release-3.2.24/CMakeLists.txt")
    add_subdirectory(third_party/SDL-release-3.2.24 EXCLUDE_FROM_ALL)
else()
    FetchContent_Declare(SDL3 URL https://github.com/libsdl-org/SDL/archive/refs/tags/release-3.2.24.tar.gz
        URL_HASH SHA256=66c374ee7f786abcd8592d18fc5b18b1e3f1c67e923867eee5f9c503cb253afd)
    FetchContent_MakeAvailable(SDL3)
endif()
set(LIBREMIDI_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LIBREMIDI_TESTS OFF CACHE BOOL "" FORCE)
set(LIBREMIDI_NO_BOOST ON CACHE BOOL "" FORCE)
set(LIBREMIDI_NO_JACK ON CACHE BOOL "" FORCE)
set(LIBREMIDI_NO_PIPEWIRE ON CACHE BOOL "" FORCE)
if(EXISTS "${PROJECT_SOURCE_DIR}/third_party/libremidi-4.5.0/CMakeLists.txt")
    add_subdirectory(third_party/libremidi-4.5.0 EXCLUDE_FROM_ALL)
else()
    FetchContent_Declare(libremidi URL https://github.com/celtera/libremidi/archive/refs/tags/v4.5.0.tar.gz
        URL_HASH SHA256=2e884a4c826dd87157ee4fab8cd8c7b9dbbc1ddb804cb10ef0852094200724db)
    FetchContent_MakeAvailable(libremidi)
endif()
set(SKIA_ROOT "${PROJECT_SOURCE_DIR}/third_party/skia" CACHE PATH "Skia source at recorded revision")
set(SKIA_LIBRARY "${SKIA_ROOT}/out/ally/libskia.a" CACHE FILEPATH "Skia Ganesh GL static library")
if(NOT EXISTS "${SKIA_ROOT}/include/core/SkCanvas.h")
    message(FATAL_ERROR "Skia missing. Run python3 x.py deps, or set SKIA_ROOT and SKIA_LIBRARY to a matching build.")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND SKIA_LIBRARY STREQUAL "${SKIA_ROOT}/out/ally/libskia.a")
    find_program(ALLY_NINJA ninja REQUIRED)
    if(NOT EXISTS "${SKIA_ROOT}/bin/gn")
        message(FATAL_ERROR "GN missing. Run python3 x.py deps.")
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/cmake/skia-linux.args" skia_args)
    string(REPLACE "\n" " " skia_args "${skia_args}")
    execute_process(COMMAND "${SKIA_ROOT}/bin/gn" gen "${SKIA_ROOT}/out/ally" "--args=${skia_args}"
        WORKING_DIRECTORY "${SKIA_ROOT}" COMMAND_ERROR_IS_FATAL ANY)
    add_custom_command(OUTPUT "${SKIA_LIBRARY}"
        COMMAND "${ALLY_NINJA}" -C "${SKIA_ROOT}/out/ally" -j 8 skia
        DEPENDS "${PROJECT_SOURCE_DIR}/cmake/skia-linux.args" VERBATIM)
    add_custom_target(ally_skia_build DEPENDS "${SKIA_LIBRARY}")
elseif(NOT EXISTS "${SKIA_LIBRARY}")
    message(FATAL_ERROR "Provide a built Ganesh GL Skia library for this platform: SKIA_LIBRARY.")
endif()
add_library(Skia::Skia STATIC IMPORTED GLOBAL)
set_target_properties(Skia::Skia PROPERTIES IMPORTED_LOCATION "${SKIA_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${SKIA_ROOT}"
    INTERFACE_COMPILE_DEFINITIONS "SK_GANESH;SK_GL")
if(TARGET ally_skia_build)
    add_dependencies(Skia::Skia ally_skia_build)
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(PkgConfig REQUIRED)
    find_package(OpenGL REQUIRED)
    pkg_check_modules(SKIA_FONT REQUIRED IMPORTED_TARGET fontconfig freetype2)
    set_property(TARGET Skia::Skia PROPERTY INTERFACE_LINK_LIBRARIES "PkgConfig::SKIA_FONT;OpenGL::GL;${CMAKE_DL_LIBS};Threads::Threads")
elseif(APPLE)
    set_property(TARGET Skia::Skia PROPERTY INTERFACE_LINK_LIBRARIES "-framework CoreFoundation;-framework CoreGraphics;-framework CoreText")
elseif(WIN32)
    set_property(TARGET Skia::Skia PROPERTY INTERFACE_LINK_LIBRARIES "opengl32;gdi32;usp10;ole32")
endif()

install(FILES "${SKIA_ROOT}/LICENSE" DESTINATION share/ally/licenses RENAME Skia.txt)
if(EXISTS "${PROJECT_SOURCE_DIR}/third_party/SDL-release-3.2.24/LICENSE.txt")
    install(FILES "${PROJECT_SOURCE_DIR}/third_party/SDL-release-3.2.24/LICENSE.txt" DESTINATION share/ally/licenses RENAME SDL3.txt)
endif()
if(EXISTS "${PROJECT_SOURCE_DIR}/third_party/libremidi-4.5.0/LICENSE.md")
    install(FILES "${PROJECT_SOURCE_DIR}/third_party/libremidi-4.5.0/LICENSE.md" DESTINATION share/ally/licenses RENAME libremidi.md)
endif()
